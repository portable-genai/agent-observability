# agent-observability Agent Observability, Audit & FinOps — example environment.
# Copy to .env (gitignored) and adjust. The dev / test default profile is `local`.

# Deployment profile: local | gcp | onprem, matched EXACTLY and case-sensitively.
#   local  -> SDK-free append-only SQLite WORM stand-in (no Google Cloud, no API key, no
#            emulators). The dev / test default; runs the whole service offline.
#   gcp    -> Cloud Logging locked-bucket WORM adapter (needs `pip install -e '.[gcp]'`).
#   onprem -> fail-fast Google Distributed Cloud migration placeholder (CLI exits 2).
# Set this DELIBERATELY. Leaving it unset (or empty) is not the same as choosing `local`:
# the local adapters still bind, but nothing is consented, so the WORM ingest refuses every
# caller and the service is confined to loopback. A value nothing binds, including the typo
# `Local`, fails the boot rather than serving with its posture guards silently unmatched.
OBSERVABILITY_PROFILE=local

# Local profile: path to the append-only SQLite WORM store.
# Empty -> ~/.observability/audit.db ; use ":memory:" for an ephemeral store.
OBSERVABILITY_LOCAL_AUDIT=

# External chain-head anchor for tamper evidence (practice C9). Empty -> a sibling
# <audit path>.anchor.json. Put it on a different volume or under different credentials
# than the store: an anchor an attacker can rewrite alongside the store detects nothing.
OBSERVABILITY_LOCAL_ANCHOR=

# Optional higher-fidelity local: route the local audit store to the official Firestore
# emulator instead of SQLite. Requires the [gcp] extra plus the google-cloud-firestore
# client installed AND the emulator running (gcloud emulators firestore start). Leave
# unset for the default SDK-free path.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# --- gcp profile only -------------------------------------------------------- #
GOOGLE_CLOUD_PROJECT=your-gcp-project
GCP_REGION=asia-southeast1
# Residency allowlist (P-03). GCP_REGION must appear here or the app fails closed at load,
# exactly as terraform plan validates var.region against var.allowed_regions. Read in three
# states: leave the LINE OUT to take the shipped allowlist; a line left blank here is an
# allowlist naming no region and refuses at load rather than inheriting the default.
OBSERVABILITY_ALLOWED_REGIONS=asia-southeast1
OBSERVABILITY_WORM_BUCKET=agent-observability-worm
OBSERVABILITY_LOG_NAME=agent-observability-audit
OBSERVABILITY_RETENTION_DAYS=2557
OBSERVABILITY_READBACK_DAYS=30
OBSERVABILITY_BQ_DATASET=agent_finops
OBSERVABILITY_BQ_TABLE=audit_events
OBSERVABILITY_S2S_AUDIENCE=
OBSERVABILITY_S2S_ALLOWED_CALLERS=
OBSERVABILITY_RELEASE_APPROVERS=
# Both are required under `gcp`: an unset audience, an audience set to an empty value, or an
# allowlist set to an empty value is a 503 on every request, never a check that quietly
# passes. The blank lines above are placeholders to FILL IN, not a working configuration.
# OBSERVABILITY_S2S_TOKEN is deliberately absent: under a deliberate `local` profile, unset
# is the documented zero-secret loopback dev opening, while a line left blank here would be
# a secret that authenticates nobody and refuses with 503 under every profile.
OBSERVABILITY_OTLP_ENDPOINT=
OBSERVABILITY_ALERT_CHANNELS=

# Distinct deployment evidence for each managed capability.
OBSERVABILITY_AUDIT_ATTESTATION_REF=
OBSERVABILITY_WORM_ATTESTATION_REF=
OBSERVABILITY_OTEL_ATTESTATION_REF=
OBSERVABILITY_FINOPS_ATTESTATION_REF=
OBSERVABILITY_SLO_ATTESTATION_REF=

# Read-back capacity retained by the local store for demos.
OBSERVABILITY_MAX_EVENTS=1000

# --- serving-path exposure ------------------------------------------------- #
# The app refuses every route to a non-loopback peer, and to any request carrying an
# x-forwarded-for / forwarded header (a relayed request cannot be shown to be loopback),
# while no profile is chosen, under `local` (a pre-shared string is not a verified caller),
# and under `onprem` (nothing verifies anybody yet). Only a caller-identity binding that
# VERIFIES its caller stands the guard down, which out of the box means `gcp`.
#
# Setting OBSERVABILITY_S2S_TOKEN does NOT lift the bound and is not meant to: it closes the
# ingest one route at a time and says nothing about /healthz and /v1/capabilities, which
# carry no credential by design. Bind a verifying scheme (docs/onprem-migration.md), or set
# this to 1 only to accept the exposure deliberately.
# OBSERVABILITY_ALLOW_INSECURE_DEMO=1

# API bind port (Cloud Run sets PORT).
PORT=8085
